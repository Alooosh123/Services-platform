# Digital TopUp & Services Platform Configuration

# System & Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api

# Docker Compose local database credentials (development only)
# These local-only defaults must never be reused for a production deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=alameire.alaa1
POSTGRES_DB=digital_topup_db

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_topup_db?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# Security & JWT Tokens
JWT_SECRET="digital-topup-jwt-access-token-secret-replace-in-production-key-998877"
JWT_REFRESH_SECRET="digital-topup-jwt-refresh-token-secret-replace-in-production-key-112233"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
SEED_SUPER_ADMIN_EMAIL="admin@digitaltopup.com"
SEED_SUPER_ADMIN_PASSWORD="Admin@123456"
RESET_DATABASE_SEED=false

# Encryption key for provider credentials and stored digital codes (32 bytes, hex).
# Generate a private value with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-a-private-64-character-hex-key"
WEBHOOK_HMAC_SECRET="replace-with-a-private-secret-of-at-least-32-bytes"

# Global payment gateways (keep disabled until provider and payment-method setup is verified).
PUBLIC_WEB_URL="http://localhost:3000"
STRIPE_SECRET_KEY="replace-with-your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-your-stripe-webhook-signing-secret"
USDT_WEBHOOK_SECRET="replace-with-a-private-secret-of-at-least-32-bytes"
USDT_USD_RATE=1
USDT_MIN_CONFIRMATIONS=12
USDT_TRC20_RECEIVER_ADDRESS="configure-a-verified-trc20-address"
USDT_BEP20_RECEIVER_ADDRESS="configure-a-verified-bep20-address"

# Frontend Applications
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_NAME="Digital TopUp Platform"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Provider Settings
MOCK_PROVIDER_LATENCY_MS=500
MOCK_PROVIDER_SUCCESS_RATE=1.0

# Security & Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
