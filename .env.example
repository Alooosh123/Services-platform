# Digital TopUp & Services Platform Configuration

# System & Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api

# MySQL 8.4 local development credentials (use unique random hex values)
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
MYSQL_USER=topup_app
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
MYSQL_DATABASE=digital_topup_db

# Database Connection (MySQL)
DATABASE_URL="mysql://topup_app:REPLACE_WITH_RANDOM_HEX_SECRET@localhost:3306/digital_topup_db"

# Redis Cache & Queue
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET

REDIS_URL="redis://:REPLACE_WITH_RANDOM_HEX_SECRET@localhost:6379"

# Security & JWT Tokens
JWT_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
SEED_SUPER_ADMIN_EMAIL="REPLACE_WITH_YOUR_BOOTSTRAP_EMAIL"
SEED_SUPER_ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD_AT_LEAST_20_CHARS"
RESET_DATABASE_SEED=false

# Encryption key for provider credentials and stored digital codes (32 bytes, hex).
# Generate a private value with: openssl rand -hex 32
ENCRYPTION_KEY="REPLACE_WITH_A_PRIVATE_64_CHARACTER_HEX_KEY"
BACKUP_ENCRYPTION_KEY="REPLACE_WITH_A_DIFFERENT_PRIVATE_64_CHARACTER_HEX_KEY"
WEBHOOK_HMAC_SECRET="replace-with-a-private-secret-of-at-least-32-bytes"

# Global payment gateways (keep disabled until provider and payment-method setup is verified).
PUBLIC_WEB_URL="http://localhost:3000"
STRIPE_SECRET_KEY="replace-with-your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-your-stripe-webhook-signing-secret"
USDT_WEBHOOK_SECRET="replace-with-a-private-secret-of-at-least-32-bytes"
USDT_USD_RATE=1
USDT_MIN_CONFIRMATIONS=12
USDT_TRC20_RECEIVER_ADDRESS="configure-a-verified-trc20-address"
USDT_BEP20_RECEIVER_ADDRESS="configure-a-verified-bep20-address"

# Frontend Applications
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_NAME="Digital TopUp Platform"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Provider Settings
MOCK_PROVIDER_LATENCY_MS=500
MOCK_PROVIDER_SUCCESS_RATE=1.0

# Security & Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=120


# Optional MikroTik read-only RouterOS monitoring (private management IPv4 only)
# Leave empty to keep the network monitoring agent disabled.
MIKROTIK_BASE_URL=
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
# Optional path to a trusted CA PEM for the RouterOS HTTPS certificate.
MIKROTIK_CA_FILE=

# Explicit opt-in for periodic read-only RouterOS polling (disabled by default)
MIKROTIK_MONITORING_ENABLED=false
MIKROTIK_POLL_INTERVAL_MS=60000
MIKROTIK_RETENTION_DAYS=90
