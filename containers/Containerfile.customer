FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/

ARG NEXT_PUBLIC_API_URL=http://localhost:4000/api
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN npm ci
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=apps/web-customer

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/web-customer/.next ./apps/web-customer/.next
COPY --from=builder /app/apps/web-customer/public ./apps/web-customer/public
COPY --from=builder /app/apps/web-customer/package.json ./apps/web-customer/package.json
COPY --from=builder /app/apps/web-customer/node_modules ./apps/web-customer/node_modules

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=apps/web-customer"]
