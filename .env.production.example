# Copy to .env.production on the VPS. Never commit actual secrets.
NODE_ENV=production
PORT=4000
API_PREFIX=api

# Generate separate random values with: openssl rand -hex 32
POSTGRES_USER=topup_app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX
POSTGRES_DB=digital_topup_prod
DATABASE_URL=postgresql://topup_app:REPLACE_WITH_RANDOM_64_HEX@postgres:5432/digital_topup_prod?schema=public

REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
REDIS_URL=redis://:REPLACE_WITH_DIFFERENT_RANDOM_64_HEX@redis:6379

JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX
WEBHOOK_HMAC_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Replace all example domains with the registered domain and configure DNS A records.
CUSTOMER_DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.example.com
SAAS_DOMAIN=saas.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_SITE_NAME=منصة الشحن والخدمات الرقمية
NEXT_PUBLIC_SITE_URL=https://shop.example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com
PLATFORM_HOSTS=shop.example.com,admin.example.com,saas.example.com,api.example.com
CORS_ORIGIN=https://shop.example.com,https://admin.example.com,https://saas.example.com

# Customer wallet deposits/withdrawals stay disabled until written regulatory approval,
# signed merchant agreements, verified commercial receiver accounts, and finance sign-off.
ENABLE_CUSTOMER_WALLET_OPERATIONS=false
# Direct test deposits are strictly local-development only; never enable on production/VPS.
ENABLE_DEV_WALLET_DEPOSIT=false
ENABLE_LEGACY_WALLET_TOPUP=false
# Assigned-agent manual deposits auto-credit only after an exact official-history match.
# This is NOT automatic wallet scraping; the assigned agent must inspect the official receiver history.
# Keep disabled until legal approval, controlled pilot, and security sign-off.
ENABLE_AGENT_AUTO_CREDIT=false
# Explicit allowlist: only named manual channels can use agent auto-credit. Empty means none.
WALLET_AGENT_AUTO_CREDIT_CHANNELS=
# Per-deposit ceilings; zero disables auto-credit for that currency.
WALLET_AGENT_AUTO_CREDIT_MAX_AMOUNT_YER=0
WALLET_AGENT_AUTO_CREDIT_MAX_AMOUNT_USD=0
WALLET_AGENT_AUTO_CREDIT_MAX_AMOUNT_SAR=0
# Mandatory per-agent UTC-day caps. Zero or missing values disable auto-credit and route to finance.
WALLET_AGENT_AUTO_CREDIT_DAILY_MAX_COUNT=0
WALLET_AGENT_AUTO_CREDIT_DAILY_MAX_AMOUNT_YER=0
WALLET_AGENT_AUTO_CREDIT_DAILY_MAX_AMOUNT_USD=0
WALLET_AGENT_AUTO_CREDIT_DAILY_MAX_AMOUNT_SAR=0
# Fresh agent TOTP and Redis anti-replay are mandatory for every auto-credit attempt.
ENABLE_MOCK_PROVIDERS=false
# Comma-separated official provider API hostnames approved after reviewing each vendor's docs.
PROVIDER_ALLOWED_HOSTS=

# External integrations remain blocked until official provider API documentation,
# owned receiver accounts, sandbox tests, production credentials and finance approval.
DEFAULT_PROVIDER_MODE=BLOCKED_EXTERNAL
JAIB_CHANNEL_MODE=BLOCKED_EXTERNAL
JAWALI_CHANNEL_MODE=BLOCKED_EXTERNAL
CASH_CHANNEL_MODE=BLOCKED_EXTERNAL
ONE_CASH_CHANNEL_MODE=BLOCKED_EXTERNAL
EASY_CHANNEL_MODE=BLOCKED_EXTERNAL

THROTTLE_TTL=60000
THROTTLE_LIMIT=60
LOG_LEVEL=warn
METRICS_ENABLED=true
