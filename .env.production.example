# =====================================================================
# Yemen Digital TopUp Platform - PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
# Phase 10: Production Readiness, Security Gate & Launch Standards (AR-16 & 09_PRODUCTION_LAUNCH_CHECKLIST)
# =====================================================================

# System & Runtime
NODE_ENV=production
PORT=4000
API_PREFIX=api

# Primary MySQL 8.4 LTS Cluster (Managed HA with automated backups and point-in-time recovery)
DATABASE_URL="mysql://prod_app_user:${PROD_DB_PASSWORD}@prod-mysql-ha.internal:3306/yemen_topup_prod?sslaccept=strict"

# Redis Cluster (Auth protected, TLS encrypted)
REDIS_URL="rediss://default:${PROD_REDIS_PASSWORD}@prod-redis-ha.internal:6379"

# Cryptographic Keys (Managed via Vault / AWS Secrets Manager / Cloud KMS - >= 32 chars non-default)
JWT_SECRET="${PRODUCTION_JWT_SECRET_FROM_VAULT}"
JWT_REFRESH_SECRET="${PRODUCTION_JWT_REFRESH_SECRET_FROM_VAULT}"
ENCRYPTION_KEY="${PRODUCTION_ENCRYPTION_KEY_FROM_VAULT}"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Domains (HSTS, TLS 1.3, Cloudflare WAF Protected)
NEXT_PUBLIC_API_URL="https://api.yementopup.com/api"
NEXT_PUBLIC_SITE_NAME="منصة الشحن والخدمات الرقمية - اليمن"
NEXT_PUBLIC_SITE_URL="https://yementopup.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.yementopup.com"

# External Provider Modes (Never claim API integration without signed contracts)
DEFAULT_PROVIDER_MODE="MANUAL"
JAIB_CHANNEL_MODE="MANUAL"
JAWALI_CHANNEL_MODE="MANUAL"
ONE_CASH_CHANNEL_MODE="MANUAL"
EASY_CHANNEL_MODE="MANUAL"

# Rate Limiting, WAF & Observability
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
CORS_ORIGIN="https://yementopup.com,https://admin.yementopup.com"
LOG_LEVEL="warn"
METRICS_ENABLED="true"

# Optional isolated RouterOS monitoring (HTTPS, dedicated read-only account, private management IP only)
# Leave empty until a test MikroTik is configured and its CA is trusted.
MIKROTIK_BASE_URL=
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_CA_FILE=

# Explicit opt-in for periodic read-only RouterOS polling (disabled by default)
MIKROTIK_MONITORING_ENABLED=false
MIKROTIK_POLL_INTERVAL_MS=60000
