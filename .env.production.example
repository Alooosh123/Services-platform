# Copy to .env.production on the VPS. Never commit actual secrets.
NODE_ENV=production
PORT=4000
API_PREFIX=api

# Set different randomly generated hex values; no default/test values.
POSTGRES_USER=topup_app
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHAR_SECRET
POSTGRES_DB=digital_topup_prod
DATABASE_URL=postgresql://topup_app:REPLACE_WITH_64_HEX_CHAR_SECRET@postgres:5432/digital_topup_prod?schema=public

REDIS_PASSWORD=REPLACE_WITH_64_HEX_CHAR_SECRET
REDIS_URL=redis://:REPLACE_WITH_64_HEX_CHAR_SECRET@redis:6379

JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHAR_SECRET
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_SECRET
WEBHOOK_HMAC_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHAR_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Replace with the actual domain names and point A records to the VPS public IP.
CUSTOMER_DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.example.com
SAAS_DOMAIN=saas.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_SITE_NAME=منصة الشحن والخدمات الرقمية
NEXT_PUBLIC_SITE_URL=https://shop.example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com
PLATFORM_HOSTS=shop.example.com,admin.example.com,saas.example.com,api.example.com
CORS_ORIGIN=https://shop.example.com,https://admin.example.com,https://saas.example.com

# External integrations stay blocked until official specs, owned receiver accounts,
# production credentials and separate finance approval have been verified.
DEFAULT_PROVIDER_MODE=BLOCKED_EXTERNAL
JAIB_CHANNEL_MODE=BLOCKED_EXTERNAL
JAWALI_CHANNEL_MODE=BLOCKED_EXTERNAL
CASH_CHANNEL_MODE=BLOCKED_EXTERNAL
ONE_CASH_CHANNEL_MODE=BLOCKED_EXTERNAL
EASY_CHANNEL_MODE=BLOCKED_EXTERNAL

THROTTLE_TTL=60000
THROTTLE_LIMIT=60
LOG_LEVEL=warn
METRICS_ENABLED=true
