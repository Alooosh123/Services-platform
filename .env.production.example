# =====================================================================
# Yemen Digital TopUp Platform - PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
# Phase 10: Production Readiness, Security Gate & Launch Standards (AR-16 & 09_PRODUCTION_LAUNCH_CHECKLIST)
# =====================================================================

# System & Runtime
NODE_ENV=production
PORT=4000
API_PREFIX=api

# Primary PostgreSQL Cluster (Managed HA with automated WAL archiving & read replicas)
DATABASE_URL="postgresql://<neon_user>:<password>@<neon-host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&schema=public&pgbouncer=true"
DIRECT_URL="postgresql://<neon_user>:<password>@<neon-host>.<region>.aws.neon.tech/<database>?sslmode=require&schema=public"

# Redis Cluster (Auth protected, TLS encrypted)
REDIS_URL="rediss://default:<upstash-password>@<upstash-tcp-host>:6379"

# Cryptographic Keys (Managed via Vault / AWS Secrets Manager / Cloud KMS - >= 32 chars non-default)
JWT_SECRET="${PRODUCTION_JWT_SECRET_FROM_VAULT}"
JWT_REFRESH_SECRET="${PRODUCTION_JWT_REFRESH_SECRET_FROM_VAULT}"
ENCRYPTION_KEY="${PRODUCTION_ENCRYPTION_KEY_FROM_VAULT}"
WEBHOOK_HMAC_SECRET="${PRODUCTION_WEBHOOK_HMAC_SECRET_FROM_VAULT}"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Domains (HSTS, TLS 1.3, Cloudflare WAF Protected)
NEXT_PUBLIC_API_URL="https://<northflank-api-domain>/api"
NEXT_PUBLIC_ENABLE_FINANCIAL_ADMIN_WRITES="false" # Keep all client-side financial actions disabled in Staging
NEXT_PUBLIC_SITE_NAME="منصة الشحن والخدمات الرقمية - اليمن"
NEXT_PUBLIC_SITE_URL="https://yementopup.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.yementopup.com"

# External Provider Modes (Never claim API integration without signed contracts)
DEFAULT_PROVIDER_MODE="MANUAL"
JAIB_CHANNEL_MODE="API"
JAWALI_CHANNEL_MODE="MANUAL"
ONE_CASH_CHANNEL_MODE="API"
EASY_CHANNEL_MODE="MANUAL"

# Rate Limiting, WAF & Observability
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
CORS_ORIGIN="https://<customer-domain>,https://<admin-domain>,https://<saas-domain>"
LOG_LEVEL="warn"
METRICS_ENABLED="true"
