{
  "name": "digital-topup-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Digital TopUp & Services Platform - Production-Ready Architecture",
  "workspaces": [
    "packages/*",
    "apps/backend",
    "apps/web-admin",
    "apps/web-customer",
    "apps/web-saas"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:admin": "npm run dev --workspace=apps/web-admin",
    "dev:customer": "npm run dev --workspace=apps/web-customer",
    "dev:saas": "npm run dev --workspace=apps/web-saas",
    "db:generate": "npm run generate --workspace=packages/database",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=packages/database",
    "db:backup": "npm run backup --workspace=packages/database",
    "db:backup:postgres": "npm run backup:postgres --workspace=packages/database",
    "db:restore": "npm run restore --workspace=packages/database --",
    "db:restore:postgres": "npm run restore:postgres --workspace=packages/database --",
    "db:push": "npm run push --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "topup",
    "gaming",
    "services",
    "fintech",
    "ledger",
    "pubg",
    "nextjs",
    "nestjs"
  ],
  "author": "",
  "license": "UNLICENSED",
  "overrides": {
    "ajv": "8.17.2",
    "body-parser": "2.4.0",
    "fast-uri": "4.2.3",
    "glob": "14.0.2",
    "js-yaml": "5.3.0",
    "lodash": "4.18.1",
    "minimatch": "11.0.1",
    "multer": "2.5.0",
    "picomatch": "4.0.7",
    "postcss": "8.5.32",
    "postcss-selector-parser": "6.1.5",
    "qs": "6.16.1",
    "tar": "7.5.22",
    "file-type": "21.3.2",
    "tmp": "0.2.7",
    "webpack": "5.111.1",
    "deepmerge": "4.3.1"
  }
}
